  "skills": [
    {
      "skill_id": "photocatalyst_scavenger_stoichiometry_match",
      "rules": [
        {
          "rule_id": "dense_catalyst_with_ample_thiol_donor",
          "conditions": [
            [
              "l_cysteine_100gl_bin",
              "high"
            ],
            [
              "p10_mix1_bin",
              "very_high"
            ]
          ],
          "weight": 0.8,
          "rationale": "Dense photocatalyst loading needs abundant cysteine hole scavenging to suppress recombination and sustain proton reduction turnover."
        },
        {
          "rule_id": "elevated_catalyst_loading",
          "conditions": [
            [
              "p10_mix1_bin",
              "high"
            ]
          ],
          "weight": 0.45,
          "rationale": "More semiconductor surface increases photon capture and active sites until optical shielding of the suspension dominates."
        },
        {
          "rule_id": "scavenger_starved_regime",
          "conditions": [
            [
              "l_cysteine_100gl_bin",
              "low"
            ]
          ],
          "weight": -0.5,
          "rationale": "Insufficient sacrificial donor leaves holes unconsumed, so recombination and photocorrosion limit hydrogen output."
        }
      ],
      "ridge": 1.0,
      "prior_scale": 0.35,
      "semantic_mass_start": 0.55,
      "semantic_mass_end": 0.15,
      "ucb_weight": 0.65,
      "gp_beta_start": 2.5,
      "gp_beta_end": 1.0,
      "gp_xi": 0.01,
      "confidence": 0.75,
      "hypothesis": "Transfers the catalyst-donor pairing heuristic: activity rises jointly with photocatalyst and sacrificial-donor levels. May fail if the pool saturates optically at very high solids or cysteine adsorbs competitively."
    },
    {
      "skill_id": "alkaline_activation_of_thiol_donor",
      "rules": [
        {
          "rule_id": "moderate_base_addition",
          "conditions": [
            [
              "naoh_1m_bin",
              "medium"
            ]
          ],
          "weight": 0.55,
          "rationale": "Alkaline pH deprotonates cysteine thiol to faster-oxidizing thiolate and improves oxide dispersion via surface charging."
        },
        {
          "rule_id": "base_plus_rich_donor",
          "conditions": [
            [
              "l_cysteine_100gl_bin",
              "high"
            ],
            [
              "naoh_1m_bin",
              "high"
            ]
          ],
          "weight": 0.4,
          "rationale": "High pH with rich donor maximizes thiolate concentration available for hole capture at the particle interface."
        },
        {
          "rule_id": "unbuffered_acidic_formulation",
          "conditions": [
            [
              "naoh_1m_bin",
              "none"
            ]
          ],
          "weight": -0.35,
          "rationale": "Without added base, protonated donor oxidizes sluggishly and near-neutral pH favors particle aggregation."
        }
      ],
      "ridge": 2.0,
      "prior_scale": 0.3,
      "semantic_mass_start": 0.45,
      "semantic_mass_end": 0.12,
      "ucb_weight": 0.5,
      "gp_beta_start": 2.0,
      "gp_beta_end": 0.9,
      "gp_xi": 0.02,
      "confidence": 0.6,
      "hypothesis": "Transfers pH-dependent scavenger kinetics as a semantic prior. Fails if the pool's base levels shift pH past the point where proton availability for reduction becomes limiting."
    },
    {
      "skill_id": "silicate_dispersant_optimum_window",
      "rules": [
        {
          "rule_id": "dilute_silicate_stabilization",
          "conditions": [
            [
              "sodium_silicate_1wt_bin",
              "low"
            ]
          ],
          "weight": 0.5,
          "rationale": "Dilute silicate raises particle surface charge, keeping the powder suspended for light capture without coating active sites."
        },
        {
          "rule_id": "silicate_overdose_passivation",
          "conditions": [
            [
              "sodium_silicate_1wt_bin",
              "very_high"
            ]
          ],
          "weight": -0.6,
          "rationale": "Excess silicate forms gel-like overlayers that block surface sites and scatter incident photons away from the semiconductor."
        },
        {
          "rule_id": "dispersant_matters_at_heavy_loading",
          "conditions": [
            [
              "p10_mix1_bin",
              "very_high"
            ],
            [
              "sodium_silicate_1wt_bin",
              "medium"
            ]
          ],
          "weight": 0.35,
          "rationale": "Concentrated suspensions sediment fastest, so moderate dispersant preserves illuminated surface area where loading is highest."
        }
      ],
      "ridge": 3.0,
      "prior_scale": 0.25,
      "semantic_mass_start": 0.4,
      "semantic_mass_end": 0.1,
      "ucb_weight": 0.55,
      "gp_beta_start": 2.2,
      "gp_beta_end": 1.1,
      "gp_xi": 0.015,
      "confidence": 0.55,
      "hypothesis": "Encodes a non-monotonic dispersant response: helpful when dilute, passivating when concentrated. May fail if silicate mainly acts as a pH modifier rather than a colloidal stabilizer here."
    },
    {
      "skill_id": "dye_sensitization_counter_hypothesis",
      "rules": [
        {
          "rule_id": "downweight_dye_addition",
          "conditions": [
            [
              "dye_presence",
              "dye_added"
            ]
          ],
          "weight": -0.55,
          "rationale": "Against sensitization expectations, added dyes compete for photons and holes, and photobleach rather than boosting evolution."
        },
        {
          "rule_id": "inner_filter_from_cationic_dye",
          "conditions": [
            [
              "methylene_blue_250mgl_bin",
              "low"
            ]
          ],
          "weight": -0.35,
          "rationale": "Strongly absorbing dye attenuates light before it reaches particles and is itself reduced by conduction-band electrons."
        },
        {
          "rule_id": "clean_optical_path_preference",
          "conditions": [
            [
              "dye_presence",
              "dye_free"
            ]
          ],
          "weight": 0.4,
          "rationale": "Dye-free mixtures leave the semiconductor as sole absorber, avoiding inner-filter losses and parasitic electron sinks."
        }
      ],
      "ridge": 5.0,
      "prior_scale": 0.2,
      "semantic_mass_start": 0.3,
      "semantic_mass_end": 0.08,
      "ucb_weight": 0.45,
      "gp_beta_start": 2.4,
      "gp_beta_end": 1.2,
      "gp_xi": 0.03,
      "confidence": 0.45,
      "hypothesis": "Deliberately reverses the uncertain assumption that added dyes sensitize the system, treating them as optical and electron sinks. Fails if any dye genuinely extends visible-light harvesting."
    },
    {
      "skill_id": "surfactant_active_site_blocking",
      "rules": [
        {
          "rule_id": "penalize_surfactant_presence",
          "conditions": [
            [
              "surfactant_presence",
              "surfactant_added"
            ]
          ],
          "weight": -0.45,
          "rationale": "Adsorbed amphiphiles occupy surface sites, hinder proton access, and can scavenge radicals without producing hydrogen."
        },
        {
          "rule_id": "anionic_surfactant_adsorption",
          "conditions": [
            [
              "sds_1wt_bin",
              "low"
            ]
          ],
          "weight": -0.35,
          "rationale": "Anionic sulfate headgroups bind oxide surfaces strongly, forming hydrophobic layers that impede interfacial charge transfer."
        },
        {
          "rule_id": "polymer_free_surface",
          "conditions": [
            [
              "pvp_1wt_bin",
              "none"
            ]
          ],
          "weight": 0.3,
          "rationale": "Omitting polymeric stabilizer leaves the semiconductor interface bare and directly accessible to donor and protons."
        }
      ],
      "ridge": 4.0,
      "prior_scale": 0.22,
      "semantic_mass_start": 0.35,
      "semantic_mass_end": 0.1,
      "ucb_weight": 0.6,
      "gp_beta_start": 1.8,
      "gp_beta_end": 0.8,
      "gp_xi": 0.02,
      "confidence": 0.5,
      "hypothesis": "Transfers interfacial site-blocking chemistry for adsorbing amphiphiles and polymers. May fail where surfactant-driven wetting or deagglomeration outweighs the loss of accessible surface sites."
    },
    {
      "skill_id": "ionic_strength_colloidal_destabilization",
      "rules": [
        {
          "rule_id": "salt_free_electrostatic_repulsion",
          "conditions": [
            [
              "nacl_3m_bin",
              "none"
            ]
          ],
          "weight": 0.4,
          "rationale": "Low ionic strength preserves double-layer repulsion, limiting aggregation that shortens optical path and buries active facets."
        },
        {
          "rule_id": "high_salt_aggregation_penalty",
          "conditions": [
            [
              "nacl_3m_bin",
              "high"
            ]
          ],
          "weight": -0.5,
          "rationale": "Concentrated chloride screens surface charge, driving rapid flocculation and sedimentation of the illuminated suspension."
        },
        {
          "rule_id": "salt_without_stabilizer",
          "conditions": [
            [
              "nacl_3m_bin",
              "medium"
            ],
            [
              "sodium_silicate_1wt_bin",
              "none"
            ]
          ],
          "weight": -0.35,
          "rationale": "Added salt with no dispersant compresses double layers unchecked, so particles settle out of the irradiated volume."
        }
      ],
      "ridge": 2.5,
      "prior_scale": 0.28,
      "semantic_mass_start": 0.38,
      "semantic_mass_end": 0.09,
      "ucb_weight": 0.4,
      "gp_beta_start": 2.8,
      "gp_beta_end": 1.3,
      "gp_xi": 0.04,
      "confidence": 0.5,
      "hypothesis": "Transfers DLVO-style colloidal reasoning: electrolyte addition suppresses suspension stability and effective illumination. Fails if chloride instead improves conductivity or the salt-containing subset is too sparse to inform the surrogate."
    }
  ],
